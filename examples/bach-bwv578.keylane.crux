// Bach, Fugue in G minor BWV 578 ("Little"), complete: 68 bars, four voices
// #pitchRegime Minor
// #tonic 55
// #keyLane 1 i~, 6 v~, 11 i~, 17:3 v~, 22 v-, 23:-1 III, 24:2 i~, 26:4 n7, 31:2 III, 32:2 #6, 34 VII, 34:3 III, 38:4 #6, 39:2 b2, 42 VII, 42:4 III, 47:3 iv-, 48 iv~, 55:2 III, 57:2 i~, 57:2 #6, 59:4 III, 60:2 #3, 60:3 VII, 60:4 #4, 61 i~, 61:3 b2, 61:3:4 n7, 62 III, 63 i~, 65:1:3 #7, 65:1:4 #6, 68 I

// ---- the subject ----
nug = [0,4,2,1]
nug_squashed = nug ^ 1/2 @[@3 -1/2]
nug_turned = (nug \1) * -3 | -1
a = nug, nug_squashed, nug_turned
ar = a . [|2,|2,|3,|,|,|,|,|,|,|,|2] // apply the rhythm

nugb = (nug * |-1) ~ -1 @[@3 -3]
b = nugb ., [-3]
br = b @[@5 [4,3]/]

nugc = (br @[@1 [0,3]/,@3 [0,4]/, @7[0,-4]/]) \1

nugd = nugb * 1 ~ 2 @[@3 -2]
nuge = (nug_squashed * | -1) ^ -1 * 2
nugf = nugb ~ -1
nugg = nuge m 1
nugh = nug @[@1 -1]             // nug with its fifth narrowed to a fourth: [0,3,2,1]
nugs = nugh @[@0 -2] * 2        // nug with the pickup dropped a third:  [0,5,4,3]
climb = nugd * |-1 * 1 @[@0 -1] // rising nugd, pickup a third below:       [0,2,3,4]
plunge = nugd @[@0 2]           // falling nugd, pickup a third above:      [5,2,1,0]
trill = [0,1] : 2

d = (4, nugd, nugd * -1, 1) * |/2
subject = ar, br, nugc, d

turn = nugf * -1 @[@1 -2]       // nugf with its neighbour dropped to the dominant
link = (turn, nugd * |-1 * 2) * |/2
nugp = nugc \2, [1,-3]

// ---- the countersubject ----
tail = nuge * [0,-1] * |/2
crest = trill * 2 * |/2, [3 | 2], (nugf * 3, nugd * 1) * |/2
hold = [0 : 4]
ped1 = (nugb * -2 @[@0 4], hold * 4, hold * 3, hold * 4)z * |/2
ped2 = (nugb * 2, hold, hold * -1, hold)z * |/2
ped3 = (nugb * 2, hold * 7, hold * 6, hold * 7)z * |/2
cs = tail, turn, crest, ped1, ped2

// ---- rhythms ----
// one cell of three even pips - most rhythms below are that cell running into a longer pip
even = [|,|,|]
to2 = even, [|2]
to4 = even, [|4]
long = even, [|5]               // three eighths into a held note
mid2 = to2 ~ 1                  // to2 with the long pip moved to third place
run = to4 * |/2                 // three sixteenths into a quarter
susp = long * |-1/2             // long backwards at half speed: a tied note resolving in sixteenths

// ---- episode figures ----
wave = (nugf * -1, nuge * -2) * |/2
dive = (nugf * -1, nugd * -3) * |/2
echo = ((nugf \1) * -1 > 1) * |/2
fourth = nugh .* long
sixth = nugs .* long
leap = [4,1,-3,3]
vault = (nugg * |-1, leap) * |/2
vault2 = (nugg * |-1, leap * -1) * |/2
arch = (climb, plunge) * |/2
third = [0,2]
sixup = [0,5]
zig = [0,9], third * [7,5,2,3,3,1,-2]
tri = nugb ^ -2 @[@3 1]          // nugb stretched into falling thirds, last pip bent up
thirds = tri .* long
thirds2 = tri .* to2, [r | 3]
sigh = nugg * |-1 .* susp
drop8 = (plunge * -5, nugb ^ -2) * |/2
lead = ([2,-1,0], nugb * 1, [3]) * |/2
held = [0, 0 | 33/2], (nugb \1) * -1 * |/2

// soprano
s1 = subject, link, cs * 4
s2 = sixup * [1,0], third * [-1,4], [0, 3, r, 0] * [5,4], nugf * 2 * |/2, (([0], (nugf \1) * 4) * [3,2,1]) * |/2
s3 = [7 | 4, r | 8], ped1, nugb * 2 * |2, [r, 2, r, 1]
s4 = [r, -3], nugg * |/2, [1, 4, 3, 5], (nugb * |-1 * 7, nugd * 3) * |/2, [4, r, 9, r, 5, r | 2], held * 8, nugd * 5 * |/2
s5 = [6 | 4, r], fourth * 4, nugh * 3 .* (even, [|5/2]), (nugf \1) * 6 * |/2, nuge * 1 .* susp
s6 = tail, (nugh m 0, turn, turn * 2 @[@1 1], turn * 4 @[@3 -2]) * |/2, (subject > -4)
s7 = arch * [0,-1,-2], (climb * -3, nugg * |-1 * 2, climb * 1, nugb * |-1 * 5, nugg * |-1 * 4, nuge * 1) * |/2, lead
s8 = (crest, ped1, ped2) * 2, (nugg * 2, nuge * 3) * |/2, wave * [4,3,2]
s9 = (sixup, [r, 0]) * [1,0,-1], ([-2,0,3,2], nugd * -2, nugd * |-1 * -3, nugg * 1) * |/2, lead
s10 = (crest \4) * 2, [6], held * 6, [3 | 3/2], ([8], nugf * 8, nugd * 6) * |/2
s11 = dive * [5,8,4,7], (nugf * 2, nugg * 3) * |/2, sigh * 6, [5 | 9/2], ([3,4,5], nugg * 6, nugg * 2) * |/2, [0, r]
s12 = subject * 3, (zig * -2 @[@0 5], zig * [-3,-4]) * |/2, sixup * [-5,-6], [0 | 2, r | 2]
s13 = vault * [0,2], vault2 * [4,5], nugd * |-1 * 6 . [|2,|,|,|6], nugf * |-1 * 6 . [|4,|4,|2,|2], [r | 3]
s14 = [4, 7, 8], (nugf * |-1 * 7, trill * 6, nugd * 5, nugd * 1) * |/2, ped1, ped2, sixup * [2,1], [7 | 8]

// alto
a1 = [r | 40], (subject, link) * -3, wave * [3,2], [1, 0, -1, -3, 0 | 2, r | 3], turn \-1, crest
a2 = [-3, r, -4, r] : 2, echo : 4, [-3 | 2, -4 | 2, -5 | 2, r | 39]
a3 = fourth * 1, nugh .* (even, [|6]), [0 | 4, -1 | 2, 0, r | 63]
a4 = (ar \1) * -5, [r, -1, -1 | 20, r | 65]
a5 = fourth * -1, sixth * -4, nugs * -5 .* (even, [|9/2]), nugd * -5 .* run, [-4 | 2, r | 3, -4, 1, -1 | 7/2], ([-1,-2,-3], nuge * -4, nuge * -5) * |/2
a6 = (turn * -4, trill * -2, nugg ^ -2, nuge * |-1 * -1, nugb * |-1 * -4) * |/2, [-5, -3, -7 | 17, 0], nuge * -3 * |/2, [-2 | 2, r | 3]
a7 = thirds * [-4,-5], tri * -6 .* to2, [r | 2], vault * -7, [-5, -3, -6, -3 | 2, 0, -4, -1 | 2, -1, -3, 0 | 2, 0, -2, 1 | 3/2]
a8 = ([5], nuge * 2, [1,4,0], nugf * |-1 * 6) * |/2, nugb ~ 2 * 4 .* ((even, [|8]) * |/2), [4 | 4, 3 | 4], ([2,4], nugf * |-1 * 1, [0], nugb * 1, [3], nugb * |-1 * 3) * |/2
a9 = nugg * |-1 * 2, [1 | 2, r, -3, -3 | 17, -2, -2, -3, -3 | 8]

// tenor
t1 = [r | 92], (subject, link) * -7, cs * -3, nugd * -4 . [|,|/2,|/2,|3/2], [-3 | /2]
t2 = dive * [-3,-7,-4,-8], [-12 | /2], nugd * |-1 * -5 .* run, [r | /2], nugd * |-1 * -6 .* run
t3 = (ar \7) * -7, (nugg * |-1 * -7, [-8,-7,-9,-8], nugh m 0 * -7, turn * -7) * |/2, (crest, ped1, ped2) * -7
t4 = [-7, -5], nuge * -6 * |/2, sigh * [-5,-6,-7], [-8 | 3], [-9], nugd * -11, [-12 | 2, r | 3], nugd * -7 .* to4, [-8 | 2, -8 | 2]
t5 = (subject > -16) * -5, (sixup, [r, -2]) * [-5,-6], [-7, -1, -4, -2], wave * [-1,-2,-3,-4]
t6 = (nugg * [-5,-4], nugb m 0 * -3, trill * -3) * |/2, crest * -3, (ped1, ped3) * -5, (nugg * |-1 * 2, nugd * -2) * |/2, [-3 | 5]
t7 = fourth * [-7,-8], nugh * -9 .* to2, nugg ~ 3 * -7 .* susp, nugg * -4 * |/2, [-6 | 4], nugd * |-1 * -7 .* mid2, [r | 36]
t8 = thirds2 * [-7,-8], tri * -9 .* to2, [r | 2], vault * -14, [-12, -10, -15, -10]
t9 = ([-7], nugd * |-1 * -8, [-5,-4,-4,-3]) * |2, nugd * |-1 * -2 .* mid2, [2], drop8 * [3,2,1], [-7, -5, -3, 0, -1, 0, -2, -1] * |/2
t10 = [0 | 3, -1, 0 | 2, 1, -3, -3 | 2, r, -8, -7, r, -4, r, -5, r, -4, r, -5, r, -6, r, -7, r, -6, r, -7, -5, -4, -6, -5 | 8]

// pedal
p1 = [r | 132], (ar, br, nugp) * -10, [-10, -14, -13 | 2, -17 | 2, r | 35]
p2 = [-14, -7, -8, -9, r, -16, r, -17, -10], nugd * -13 . [|24,|4,|4,|2], nugd * -15 . [|,|,|2,|2], [r | 66]
p3 = (ar, br, nugp) * -12, [-10, -9, -8, -15, -12 | 2, r | 2, -11 | 2, r | 2, -15 | 2, r | 2, -12 | 2, r | 2, -16 | 2, r | 2, -13 | 2, r | 2, -17 | 2, -14 | 2, -18 | 2, r | 2, -15 | 2, r | 2, -14 | 8]
p4 = [-18, -14, -11, -10, -9 | 2, -8 | 2, -7 | 5/2], [-7, -8, -7] * |/2, ped1 * -11, (ped3 * [-11]) \4, [-7, -5, -6, -5] * |/2, climb * -11, [-11 | 2, r | 66]
p5 = (ar, br, nugp) * -7, [-7, -9, -11, -10, -14 | 8]


// at last, the four voices
s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14
!
a1, a2, a3, a4, a5, a6, a7, a8, a9
!
t1, t2, t3, t4, t5, t6, t7, t8, t9, t10
!
p1, p2, p3, p4, p5


// #quanta 8n
// #bpm 72
// #octave -1
// #volume 3
// #loopDur 128m
// #eval New('AnnotationImage', {uploadedURL: '/media/scores/BachFugue_BWV578_p1.png'})