// Bach, Invention No. 1 in C major, BWV 772
// #pitchRegime Major
// One unit is a sixteenth. 0 is middle C. A half step is an accidental (7/2 is F sharp).

// ---- your material ----
P = 3
A = [0 -> P]
b1 = [P -> 2]
B = (b1, b1 * -2)z
T = A, B \ -1
C = [4, 7, 6, 7, 8 | /2]

// ---- built from it ----
// I   subject upside down
// Ai  falling tetrachord
// S   subject and its tail, one bar
// E   subject, then the answer a fifth up (bars 1-2)
// U   the subject's tail with its landing a step up
// G   subject landing a step up (A, then U). F is G upside down
// Ge  G landing on an eighth. M is G with the landing held. N is Ge as a lone entry after a rest
// H   subject landing on P, the top of its tetrachord (LH bars 2 and 5, RH bar 20)
// A6  A overlapped with itself a third up: a six-note rise
// K   cadence: falling third and an anticipation (RH bars 6, 14, 20)
// dot dotted step up (RH bar 5, LH bars 6 and 13)
// D   tail for the inverted subject, from b1 and B. J is the inverted bar
// Z   rising thirds
// Y   tetrachords in falling thirds. W is Y in eighths with its last tetrachord run on to A6, the walking line
// O   octave drop
// Q   the long sequence and cadence (RH bars 3-6, LH bars 11-14)

I = T m 0
Ai = A m 0
S = T, C * |2
E = S, (S \ 1) * 4
U = B \ -1, [1]
G = A, U
F = G m 0
Ge = G @ [@-1 | 2]
M = G @ [@-1 | 9]
N = [r | 7], Ge
H = (T, [P]) @ [@-1 | 2]
A6 = A, (A \ -2) * 2
K = (Ai \ 1) @ [@0 | 2], [-2]
dot = [0 | 3, 1]
D = (b1, B \ 2) * |2, [2]
J = I * 4, D
Z = (A * 1, A)z
Y = A * [-1, -3, -5]
W = ((Y \ 4, A6 * -5) * |2) @ [@9 1/2, @-1 | 5]
O = [0 | 2, -7 | 2]
Q = (F * [12, 10, 8, 6]) @ [@27 1/2, @31 | 2], [1 | 2], dot * 7, [6], F * 5 @ [@5 1/2], Z * 5

// ---- right hand ----
R1 = [r], E, [9]
R2 = Q @ [@38 1/2], [6 | /2, 7 | /2, 8, 11], K * 6 @ [@-1 | 2]
R3 = (N * [4, 5]) @ [@8 -3/2], (N m 0) * 8, ((N m 0) * 9) @ [@6 1/2]
R4 = W * 8 @ [@0 1/2, @6 1/2, @8 1/2], T * 2 @ [@1 1/2, @2 1/2, @4 1/2, @5 1/2]
R5 = [9], ((U m 0) * [9, 8, 13]) @ [@9 1/2], (B \ -1) * 8, [9/2], (Ai \ 1) * 10, K * 7
R6 = ((M m 0) * 12, M * 9) * [0, -1]
R7 = G * [7, 9], H * 11, [11 | 2], K * 9
R8 = F * 6 @ [@0 -1/2, @6 -1/2], [6, 7, 2, 1, 7, 3, 6], [2 | 16 & 4 & 7]
RH = R1, R2, R3, R4, R5, R6, R7, R8

// ---- left hand ----
L1 = [r | 9], T * -7, O * -3, [r | 5], H * -3, W
L2 = H * -6 @ [@2 1/2, @5 1/2], A6 * -8 * |2 @ [@4 1/2], [-5 | 2], dot * -8, O * -6
L3 = [r], E * -10 @ [@9 1/2, @14 1/2, @17 1/2], [-3], J * [0, 1]
L4 = Q * -6 @ [@0 -1/2, @6 -1/2, @39 1/2, @-1 | 2], [-2 | 2], O * [2, -2], [r | 5]
L5 = (((M m 0) * 2, M * -2) * [0, -1]) @ [@5 1/2, @26 -1/2, @29 -1/2, @-1 | 2]
L6 = (((Y m -1) \ 1) * |2) @ [@0 -1/2, @6 -1/2], [2], Ge * -6
L7 = A * -7 . [|2, |2, |2, |], (A \ -1) * -7, O * -3, [-14 | 16 & -7]
LH = L1, L2, L3, L4, L5, L6, L7

RH
!
LH
