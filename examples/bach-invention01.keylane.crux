// Bach, Invention No. 1 in C major, BWV 772
// #pitchRegime Major
// #quanta 16n
// #keyLane 1 I, 4:2 V, 9 I, 10:4 ii~, 12 vi~, 15 I, 15:4:3 #1, 18:3 IV, 20 I, 21 IV, 21:3 I

// ---- Andy Nubbins ----
PA = 0
PB = 3
A = [PA -> PB]
Ai = A m 0
b1 = [PB -> PA + 2]
B = b1 z (b1 * -2)
T = A, B \ -1
C = [4, 7, 6, 7, 8 | /2]
S = T, C * |2

// ---- built from it ----
// E   subject, then the answer a fifth up (bars 1-2)
// U   the subject's tail with its landing a step up
// G   subject landing a step up (A, then U). F is G upside down
// Ge  G landing on an eighth. M is G with the landing held. N is Ge as a lone entry after a rest
// H   subject landing on PB, the top of its tetrachord (LH bars 2 and 5, RH bar 20)
// A6  A overlapped with itself a third up: a six-note rise
// K   cadence: falling third and an anticipation (RH bars 6, 14, 20)
// dot dotted step up (RH bar 5, LH bars 6 and 13)
// D   tail for the inverted subject, from b1 and B. J is the inverted bar
// Z   rising thirds
// Y   tetrachords in falling thirds. W is Y in eighths with its last tetrachord run on to A6, the walking line
// O   octave drop
// Q   the long sequence and cadence (RH bars 3-6, LH bars 11-14)

E = S, (S \ 1) * 4
U = B \ -1, [1]
G = A, U
F = G m 0
Ge = G @ [@-1 | 2]
M = G @ [@-1 | 9]
N = [r | 7], Ge
H = (T, [PB]) @ [@-1 | 2]
A6 = A, (A \ -2) * 2
K = (Ai \ 1) @ [@0 | 2], [-2]
dot = [0 | 3, 1]
D = (b1, B \ 2) * |2, [2]
J = (T m 0) * 4, D
Z = (A * 1, A)z
Y = A * [-1, -3, -5]
W = ((Y \ 4, A6 * -5) * |2) @ [@-1 | 5]
O = [0 | 2, -7 | 2]
Q = (F * [12, 10, 8, 6]) @ [@31 | 2], [1 | 2], dot * 7, [6], F * 5, Z * 5


// ---- right hand ----
R1 = [r], E, [9]
R2 = Q, [6 | /2, 7 | /2, 8, 11], K * 6 @ [@-1 | 2]
R3 = (N * [4, 5]) @ [@8 -2], (N m 0) * 8, ((N m 0) * 9)
R4 = W * 8, T * 2
R5 = [9], ((U m 0) * [9, 8, 13]), (B \ -1) * 8, [4], (Ai \ 1) * 10, K * 7
R6 = ((M m 0) * 12, M * 9) * [0, -1]
R7 = G * [7, 9], H * 11, [11 | 2], K * 9
R8 = F * 6, [6, 7, 2, 1, 7, 3, 6], [2 | 16 & 4 & 7]
RH = R1, R2, R3, R4, R5, R6, R7, R8

// ---- left hand ----
L1 = [r | 9], T * -7, O * -3, [r | 5], H * -3, W
L2 = H * -6, A6 * -8 * |2, [-5 | 2], dot * -8, O * -6
L3 = [r], E * -10, [-3], J * [0, 1]
L4 = Q * -6 @ [@-1 | 2], [-2 | 2], O * [2, -2], [r | 5]
L5 = (((M m 0) * 2, M * -2) * [0, -1]) @ [@-1 | 2]
L6 = (((Y m -1) \ 1) * |2), [2], Ge * -6
L7 = A * -7 . [|2, |2, |2, |], (A \ -1) * -7, O * -3, [-14 | 16 & -7]
LH = L1, L2, L3, L4, L5, L6, L7

RH
!
LH

// #eval New('AnnotationImage', {uploadedURL: '/media/scores/BachInventionNo1_BWV772.png'})


