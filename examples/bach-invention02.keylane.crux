// Bach, Invention No. 2 in C minor, BWV 773
// #pitchRegime Minor
// #tonic 0
// #quanta 16n
// #meter 4/4
// #keyLane 1 i~, 1:2 III, 2 i, 3:3:2 n7, 4:3 III, 11 VII, 11:4 v, 12:2 v+, 13:2 VII, 14 v, 14:3 VII, 21:1:4 #4, 22 i~, 23:2 III, 24 i~, 25:2 III, 26 i~
//
// Hand analysis. Notes from the Humdrum edition (humdrum-tools/inventions,
// kern/inven02.krn). Steps are scale degrees of C minor, 0 = C. One unit is a sixteenth.
// Cells are written near 0 and placed by the transpositions in the two voice lines;
// the treble is written an octave low and lifted by the final * [7].
//
// The piece is a canon at the octave, two bars apart. L is the 8-bar line it is
// built from (A is the subject head, B its answering run, C8 the rising sequence
// of bar 8), and C9 carries the treble on to bar 10. The bass follows L two bars
// later an octave lower, with one note split in bar 6.
// At bar 11 the voices swap and move to G minor: the bass leads with L and C9,
// and the treble follows two bars later an octave higher. T11 is the free treble
// against the bass entry. In bars 21 and 22 both hands take C8. The treble brings
// back the subject in C minor at bar 23, and the bass answers it two octaves
// lower at bar 25. Kt and Kb are the endings.

// Cells
d7 = [0, -1, -2, -3, -4, -5, -6]
dn = d7 \ 3
p = [0, 0, -1, r]
// The line
A = [0, -1, 0, 1, 2, -3, -2, -1, -2, -4], (dn * [3])
Bh = [-1], (d7 * [5]), [0]
B = Bh, [1, 0, 1, 1 | 3, 0 | 1/2, 1 | 1/2]
Q = [2, 1, 0, 1, 2, 3], ((p * [4]) || [2])
C8 = [-5, -2, -3, 0, -1, 1, 0, 3, 2, 1, 0, -1, 2, 1, 2]
C9 = ([0, 2, 1, 2] * [4, 2]), ((dn m [0]) * [0, 1, 2]), ([1, 0, 2, 1, 0, -1, -2, 0, -4 | 5] * [5])
L = A, B, (Q, ((p * [3]) || [2]), [1 | 2, 2 | 2, -2 | 3, -4, -1, -4]), ([-3 | 2, 2 | 3, 1, 2, -1, 0, 2], (d7 * [5]), [1], (d7 * [4]), [0, 3, 0, 1 | 3, 1]), ([2, -1, 0, -1, 4 | 5, -1, 0, -1, 5 | 5]), (C8 * [4])
// Free parts and endings
T11 = [1, 4, 1, 2, 0, 1, -1, 0 | 5, 4, 3, 5, 0, -1, 0 | 3, 3, 2, 1, 6 | 3, 2, 3 | 3, 4]
T21 = (dn * [1]), [1, 0], ((d7 \ 2) * [2]), [0, 3 | 5]
Kt = [3 | 2, 3 | 2, 2, 1, 4, 3, 5, 4, 4 | 3, 5, 1 | 3, 0, 0 | 16]
Kb = [-1], (d7 * [3]), (dn * [-4]), [-3 | 2, -10 | 2], ([0 | 3, 1, 2, 3], ((p * [4]) || [2]), [3 | 2, 3 | 2, 2 | 3, 3], (d7 * [2]), [-5, -4, -3, -7 | 2], A, Bh, [-3, -2, -4, -3 | 2, -3 | 2, -7 | 16]) * [-7]
// Treble: L and C9, T11, L in G minor, T21 and C8, the subject from bar 23, ending
([r | 2], L, C9, T11, [4 | 2], (L * [-3]), T21, (C8 * [2]), [2, 1], A, B, Q, Kt) * [7]
!
// Bass: L an octave down from bar 3, L and C9 in G minor from bar 11, C8, ending with the subject
[r | 34], (L @ [@45 [0 | 2, 0]/]), [4 | 2], (((L @ [@0 -2]), C9) * [-3]), (C8 * [-1]), Kb
