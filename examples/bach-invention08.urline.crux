// Bach, Invention No. 8 in F major, BWV 779
// #pitchRegime Major
// #tonic 5
// #bpm 100
// #quanta 4n
// #loop 25m
// #minVel 80
// #maxVel 93
// #preset Seaward Piano
//
// An experiment. The same notes as bach-invention08.keylane.crux, written a
// different way: no definition states a note length.
//
// Each definition is one bar, closed with the subdivide operator, so it lasts
// one unit whatever it holds. Twelve notes in a bar are sixteenths and six are
// eighths. A weight (7 | 2) makes one note twice as long as its neighbours.
// The voices are then lines of even bars. The final * [7 | 3] lifts each hand
// an octave and makes a bar three quarter notes.
//
// Steps are scale degrees of F major, 0 = F below middle C. The key lane is
// the same as in the other file. See docs/crux-key-lane.md.
//
// #meter 3/4
// #keyLane 1 I, 7 V, 9:-1 I, 9 V, 15 ii, 16 IV, 19 vi, 21 I, 22 vi+, 24 I, 26:-1 IV, 29 I, 31:-1 IV, 31 I

// Cells shorter than a bar. They have no length until a bar holds them.
q  = [0, 1, 0, -1]                       // one beat of four
tr = [0, 2, 1, 2]                        // one beat of the trill
a5 = [0, 2, 0, 4, 0]                     // broken chord, after the first eighth of a bar
rn = [6, 5], (q * [4, 2])                // run, after the first eighth of a bar

// The subject, three bars: a broken chord, a run, a wider broken chord.
a  = ([r], a5)/
b  = ([7 | 2], rn)/
c  = [0, 2, 4, 2, 7, 4]/
S  = a, b, c

// One-bar figures.
D  = (tr : 3)/                                           // trill figure
Dq = D * [9, 7, 5]                                       // m4-6, falling by thirds
Z  = [0, -2, 2, 0, 4, 2]/
G  = ((q * [8, 6, 4])/), (([2 | 2], (rn * [-1]))/)       // m8-9, answered a bar later at the ninth below
P  = [0, -1, 0, 5, 0, 5, -1, 5, 0, 5, -2, 5]/            // pedal figure
O  = [0, -6, 0, -6, 0, -6]/
F  = [0, -1, 0, 2, -4, 2, -3, 2, -2, 2, -4, 2]/
X  = [0, -2, -4, -2, -6, -4]/
Y  = [0, -2, -4, -2, -6, 0]/
W  = [-7, 0, -1, 0, -4, 0, -3, 0, -2, 0, -4, 0]/

// m4-11 in each hand. The same eight bars return a fifth lower at m26.
ER = Dq, (Z * [3]), G, (((q * [-1]), [-3 | 2, 4, 3, 4 | 2, -1 | 2])/), ([0, 4, -1, 4, -2, 3]/)
EL = (c * [-7]), (Dq * [-7]), ([-4, -6, -3, -6, -1, -3]/), (G * [-8]), (((q * [-9]), [-6, -7, -8, -7, -6 | 2, -13 | 2])/)

// Right hand, by passage
// m1-11: subject, then ER. The left hand follows in canon at the octave until m7.
r1 = S, ER
// m12-18: cadence in C. The subject answers the left hand, then returns on G.
r2 = ([4, r | 2]/), (a * [4]), (b * [4]), (P * [4]), (([3], (a5 * [1]))/), (b * [1]), (c * [1])
// m19-25: sequences
r3 = (O * [10]), ([5, 2, 7, 5, 9, 7]/), (F * [8, 7, 6]), (Y * [7, 6])
// m26-34: m4-11 a fifth lower, and the last chord
r4 = (ER * [-4]), [-5 | 1/3]

// Left hand, by passage
// m1-11: a bar of rest, the subject an octave lower, then EL
l1 = [r], (a * [-7]), (b * [-7]), EL
// m12-18: subject in C, then its run and head on other degrees
l2 = (S * [-10]), (O * [-1]), (b * [-13]), (([-13], (a5 * [-6]))/), (b * [-6])
// m19-25: sequences
l3 = (P * [-6, -7]), (X * [-4, -5, -6]), (W * [-9, -10])
// m26-34
l4 = (EL * [-4]), [-14 | 1/3]

// Right hand
(r1, r2, r3, r4) * [7 | 3]
!
// Left hand
(l1, l2, l3, l4) * [7 | 3]
!
// Last chord, two more notes
[r | 99, 4]
!
[r | 99, 7]
