// Balinese gamelan: layered polyphonic composition.
// Gamelan music stratifies into voices that play simultaneously at
// different rates over a shared cyclic structure. Each section here is
// a voice — bare ! means "this voice also enters at t=0." Pelog scale
// approximated as [0, 1, 3, 5, 7, 8, 10].

// Shared definitions are visible to every voice that follows.
gangsa_p = [0, 3, 5, 3, 0, 3, 5, 3, 7, 5, 3, 5, 7, 5, 3, 5]
gangsa_s = [r, 5, r, 7, r, 5, r, 8, r, 8, r, 7, r, 8, r, 10]

// Voice 1: gong — slowest layer, marks the cycle.
[0 | 16]

!

// Voice 2: kempur — mid-tempo punctuation.
[5 | 8, 0 | 8]

!

// Voice 3: kempli — steady time keeper.
[0 | 2] : 8

!

// Voice 4: gangsa polos (interlocking low part).
gangsa_p

!

// Voice 5: gangsa sangsih (interlocking high part, rests where polos plays).
gangsa_s
