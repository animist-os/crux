// bwv1.6: Wie schön leuchtet der Morgenstern
// #pitchRegime Major
// #tonic 5
// #tonicMidi 65
// #lens diatonic
// #keyFifths -1
// kernel k1=2 k2=0: 27 numbers for 70 notes (A 3 mots 2 numbers, R 8 mots 15 numbers, voice lines 10)
// fit: 100.0% of sounding time at the right pitch, 100.0% of notes struck right, 0.0% extra onsets
// wiggle: 27 step numbers. Raising one moves 4 notes (median), 8.1 (mean), up to 61. 5 move 10 or more notes, 0 move more than one voice
A1 = [0]
A2 = [r]
A3 = [0 | 2]
R1 = A1, (A1 * [-1])
R2 = A1, R1
R3 = A1, (A1 * [4])
R4 = R1, (A3 * [-2])
R5 = R2, (A1 * [-1])
R6 = R1, (R4 * [-2]), (A1 * [-5])
R7 = R3, (A1 * [2]), R3, (R5 * [5]), (A1 * [5]), (A1 * [6]), (R1 * [7]), (R2 * [5]), (A1 * [2]), (R6 * [5])
R8 = A3, (A3 * [-2])
// S
(R7 * [0, 0]), A2, (R8 * [4, 4]), (R5 * [2]), (R2 * [2]), (A1 * [2]), (R4 * [3]), A3, (R1 * [7]), (R6 * [5])
