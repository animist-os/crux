R2 = A1, (A2 * [2])
R3 = A1, A2
R4 = R3, (A1 * [4]), (A2 * [2])
R5 = R3, (R1 * [2]), (R2 * [2]), (A1 * [3]), (R1 * [2]), A2
R6 = A1, (R3 * [1])
