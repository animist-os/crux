// kernel k1=2 k2=0 lossy=0.5: 23 numbers for 46 notes (A 2 mots 2 numbers, R 6 mots 9 numbers, voice lines 12)
// fit: 90.5% of sounding time at the right pitch, 82.6% of notes struck right, 2.2% extra onsets
// wiggle: 23 step numbers. Raising one moves 3 notes (median), 5.1 (mean), up to 23. 4 move 10 or more notes, 0 move more than one voice
A1 = [0]
A2 = [0 | 2]
